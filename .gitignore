# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test, type-checker, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# Local virtual environments
.venv/
venv/
env/

# Editor and operating-system metadata
.idea/
.vscode/
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.log
*~

# Generated figures and image artifacts. Final paper assets can be added
# deliberately when future analysis is frozen.
*.fig
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tif
*.tiff
*.webp
*.svg
*.eps

# Device backups are retained locally only
/artifacts/pololu_backup_*/

# Transient study execution state
/study/output/
/study/native_gates/
/study/frozen/
/study/native_device_leases/
/configs/local/
/Simulation/Architecture/allocator_replay/builds/
