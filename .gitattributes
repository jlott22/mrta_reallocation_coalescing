# Auto detect text files and perform LF normalization
* text=auto
*.zip binary

# Preserve canonical result and provenance bytes across Windows and Linux.
/results/**/combined/*.csv -text
/results/**/artifacts/** -text
/results/analysis/archive/** -text
/study/generated/manifests/** -text

# Keep the canonical Paper-V2 summary in Git LFS (it exceeds GitHub's 100 MB limit).
/paper_v2_data_bundle/core/call_epoch_trial_summary.csv filter=lfs diff=lfs merge=lfs -text
